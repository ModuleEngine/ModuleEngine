+pub fn replace_shared_value(
+    target: &mut std::sync::Arc<serde_json::Value>,
+    replacement: serde_json::Value,
+) {
+    if let Some(owned) = std::sync::Arc::get_mut(target) {
+        *owned = replacement;
+    } else {
+        *target = replacement.into();
+    }
+}
