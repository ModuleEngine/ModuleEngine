+//! Temporary RV-C.4 benchmark counters, on the single game thread.
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+#[derive(Clone, Copy, PartialEq)]
+pub enum Mode {
+    Total,
+    Sections,
+    Components,
+}
+
+#[derive(Clone, Copy)]
+pub enum Section {
+    Resources,
+    Events,
+    SystemStates,
+    ModuleData,
+    Control,
+    FrameValueClone,
+    FrameDecode,
+    FrameEncode,
+    ResourceRefreshClone,
+    EventProjection,
+}
+
+const NAMES: [&str; 10] = [
+    "checkpoint_resources",
+    "checkpoint_events",
+    "checkpoint_system_states",
+    "checkpoint_module_data",
+    "checkpoint_control",
+    "arpg_frame_json_clone",
+    "arpg_frame_decode",
+    "arpg_frame_encode",
+    "refresh_resource_json_clone",
+    "refresh_events_json_encode",
+];
+
+thread_local! {
+    static MODE: Cell<Mode> = const { Cell::new(Mode::Total) };
+    static SECTIONS: RefCell<[[u64; 2]; NAMES.len()]> = const { RefCell::new([[0; 2]; NAMES.len()]) };
+    static COMPONENTS: RefCell<BTreeMap<String, [u64; 3]>> = const { RefCell::new(BTreeMap::new()) };
+}
+
+pub fn start(mode: Mode) {
+    SECTIONS.with(|data| *data.borrow_mut() = [[0; 2]; NAMES.len()]);
+    COMPONENTS.with(|data| data.borrow_mut().clear());
+    MODE.set(mode);
+}
+
+pub fn time<T>(section: Section, operation: impl FnOnce() -> T) -> T {
+    if MODE.get() != Mode::Sections {
+        return operation();
+    }
+    let started = Instant::now();
+    let result = operation();
+    let nanos = started.elapsed().as_nanos() as u64;
+    SECTIONS.with(|data| {
+        let [calls, ns] = &mut data.borrow_mut()[section as usize];
+        *calls += 1;
+        *ns += nanos;
+    });
+    result
+}
+
+pub fn component(name: &str, present: bool, decoded: bool) {
+    if MODE.get() == Mode::Components {
+        COMPONENTS.with(|data| {
+            let mut data = data.borrow_mut();
+            let [attempts, found, valid] = data.entry(name.to_owned()).or_default();
+            *attempts += 1;
+            *found += u64::from(present);
+            *valid += u64::from(decoded);
+        });
+    }
+}
+
+pub fn stop() -> serde_json::Value {
+    MODE.set(Mode::Total);
+    serde_json::json!({
+        "sections": SECTIONS.with(|data| NAMES.into_iter().zip(*data.borrow()).collect::<BTreeMap<_, _>>()),
+        "components": COMPONENTS.with(|data| data.take()),
+    })
+}
